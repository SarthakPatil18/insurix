# Insurix Backend Environment Configuration
# Copy to .env and configure values for production

# Database (PostgreSQL with pgvector for production; SQLite memory fallback used if unset)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insurix_db

# LLM & Reasoning
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding & Vector Search
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
SIMILARITY_THRESHOLD=0.45
TOP_K=5
RRF_K=60

# Chunking Parameters
CHUNK_TOKENS=500
CHUNK_OVERLAP=0.15

# Security & Limits
MAX_UPLOAD_BYTES=10485760
SESSION_TTL_SECONDS=86400
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://sarthakpatil18.github.io"]

# Application & Logging
APP_ENV=development
LOG_LEVEL=INFO
PORT=8123
